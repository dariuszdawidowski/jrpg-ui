{
  "name": "jrpg-ui",
  "version": "0.1.0",
  "description": "2D user interface widgets for JRPG-like browser games",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/jrpg-ui.js",
  "module": "./dist/jrpg-ui.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/jrpg-ui.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
